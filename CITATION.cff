    given-names: "Edvard"
    email: "edvard.ehler@img.cas.cz"
    orcid: "https://orcid.org/0000-0003-1774-0091"
    affiliation: >-
      Laboratory of Genomics and Bioinformatics, Institute of Molecular Genetics
      of the ASCR, v. v. i., Prague, Czech Republic
  - family-names: "Moravčík"
    given-names: "Ondřej"
  - family-names: "Nógell"
    given-names: "Adam"
    email: "adam.nogell@img.cas.cz"
    orcid: "https://orcid.org/0009-0003-7430-8024"
    affiliation: >-
      Laboratory of Genomics and Bioinformatics, Institute of Molecular Genetics
      of the ASCR, v. v. i., Prague, Czech Republic

contact:
  - family-names: "Ehler"
    given-names: "Edvard"
    email: "edvard.ehler@img.cas.cz"

keywords:
  - bioinformatics
  - population genetics
  - selection scan
  - XP-EHH
  - XP-nSL
  - Hudson's FST
  - Tajima's D
  - heatmap
  - data visualization
  - 1000 Genomes Project
  - GGVP

